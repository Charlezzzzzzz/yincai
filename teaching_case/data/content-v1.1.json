  "misconceptions": [
    {
      "id": "M1",
      "name": "移项不变号",
      "example": "x+3=5 → x=5+3",
      "belief": "把移项当机械搬家，不知道来自两边同减",
      "strategy": "balance+context",
      "related_kp": [
        "K8",
        "K4"
      ]
    },
    {
      "id": "M2",
      "name": "去分母漏乘不含分母的项",
      "example": "x/2+1=x/3 ×6 → 3x+1=2x",
      "belief": "以为只有带分母的项要乘",
      "strategy": "substitute_conflict+balance",
      "related_kp": [
        "K10",
        "K5"
      ]
    },
    {
      "id": "M3",
      "name": "去分母后分子未作整体",
      "example": "(x−1)/2 ×6 → 3x−1",
      "belief": "没意识到分数线有括号作用",
      "strategy": "diagram+contrast",
      "related_kp": [
        "K10",
        "P4"
      ]
    },
    {
      "id": "M4",
      "name": "去括号符号错误",
      "example": "−2(x+2) → −2x+4",
      "belief": "负号没有分配到括号内每一项",
      "strategy": "stepwise_diagram",
      "related_kp": [
        "K9",
        "P4",
        "P2"
      ]
    },
    {
      "id": "M5",
      "name": "去括号漏乘",
      "example": "2(x+3) → 2x+3",
      "belief": "分配律只作用第一项",
      "strategy": "area_model",
      "related_kp": [
        "K9",
        "P4"
      ]
    },
    {
      "id": "M6",
      "name": "系数化为1除反",
      "example": "3x=12 → x=3/12 或 36",
      "belief": "分不清谁除以谁",
      "strategy": "substitute_conflict+balance",
      "related_kp": [
        "K6",
        "K5"
      ]
    },
    {
      "id": "M7",
      "name": "负系数丢符号",
      "example": "−2x=8 → x=4",
      "belief": "只看系数绝对值",
      "strategy": "substitute_conflict",
      "related_kp": [
        "K6",
        "P2"
      ]
    },
    {
      "id": "M8",
      "name": "等号当作“得到结果”",
      "example": "2x+4=10=2x=6=x=3",
      "belief": "等号理解为运算结果而非相等关系",
      "strategy": "balance+discussion",
      "related_kp": [
        "P6",
        "K1"
      ]
    },
    {
      "id": "M9",
      "name": "不理解方程的解",
      "example": "判断x=2是否为解时坚持先解方程",
      "belief": "把解当过程终点，不会代入",
      "strategy": "substitute_habit",
      "related_kp": [
        "K3"
      ]
    },
    {
      "id": "M10",
      "name": "等量关系方向弄反",
      "example": "甲比乙多5，设乙x，写甲=x−5",
      "belief": "按字面顺序翻译",
      "strategy": "segment_diagram+check",
      "related_kp": [
        "K12",
        "K13",
        "K16"
      ]
    }
  ],
